[
  {
    "label": "httpYac: Run request",
    "command": "tmp=$(mktemp \"$HTTPYAC_DIR/httpyac-XXXXXXXX.http\") || exit 1; trap 'rm -f \"$tmp\"' EXIT; printf '%s' \"$HTTPYAC_SOURCE\" > \"$tmp\" || exit 1; httpyac send --line \"$HTTPYAC_LINE\" \"$tmp\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": false,
    "show_command": false,
    "save": "none",
    "tags": [
      "httpyac-request"
    ],
    "env": {
      "HTTPYAC_SOURCE": "$ZED_CUSTOM_source",
      "HTTPYAC_LINE": "$ZED_ROW",
      "HTTPYAC_DIR": "$ZED_DIRNAME"
    }
  },
  {
    "label": "httpYac: Run all requests",
    "command": "httpyac",
    "args": [
      "send",
      "--all",
      "$ZED_FILE"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": false,
    "show_command": false,
    "save": "current"
  }
]
